<%- include("partials/header.ejs") %>

<h2>My Books</h2>
<p>I have currently read 6 books as of November 2026. You can add, edit, or delete book entries on this
    list as you please.</p>

<button type="submit" class="btn add-btn">
    <a href="/add">Add Book</a>
</button>

<div class="grid">
    <% if (locals.books) { %>
        <% for (let book of locals.books) { %>
            <img src="<%= book.cover_img_src %>" alt="<%= book.title %> cover">
            <div>
                <h3><%= book.title %></h3>
                <div class="book-information">
                    <p><%= book.date.toDateString() %></p>
                    <p><%= book.rating %> / 10</p>
                </div>
                <p><%= book.notes %></p>
                <div class="buttons">
                    <form action="/edit" method="POST">
                        <input type="hidden" name="id" value="<%= book.id %>">
                        <button type="submit" class="btn edit-btn">Edit</button>
                    </form>
                    <form action="/delete" method="POST">
                        <input type="hidden" name="id" value="<%= book.id %>">
                        <button type="submit" class="btn delete-btn">Delete</button>
                    </form>
                </div>
            </div>
        <% } %>
    <% } %>
</div>

<%- include("partials/footer.ejs") %>