<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Book Notes</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cantarell:ital,wght@0,400;0,700;1,400;1,700&family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/styles/styles.css">
    </head>

    <body>
        <div class="flex">
            <div>
                <h1>Book Notes</h1>
                <h2>My Books</h2>
                <p>I have currently read 6 books as of November 2026. You can add, edit, or delete book
                    entries on this list as you please.</p>

                <div>
                    <% for (let book of locals.books) { %>
                        <h3><%= book.title %></h3>
                        <div class="book-information">
                            <p><%= book.date.toDateString() %></p>
                            <p><%= book.rating %> / 10</p>
                        </div>
                        <p><%= book.notes %></p>
                    <% } %>
                </div>
            </div>
        </div>
    </body>
</html>