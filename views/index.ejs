<%- include("partials/header.ejs") %>

<h2>My Books</h2>
<% if (locals.books) { %>
    <p>I have currently read <%= locals.books.length %> books as of
        <%= new Intl.DateTimeFormat("en-US", {month: "long"}).format(new Date()) %>
        <%= new Date().getFullYear() %>.
        You can add, edit, or delete book entries on this list as you please.</p>
<% } else { %>
    <p>I have currently read no books as of
        <%= new Intl.DateTimeFormat("en-US", {month: "long"}).format(new Date()) %>
        <%= new Date().getFullYear() %>.
        You can add, edit, or delete book entries on this list as you please.</p>
<% } %>

<button type="submit" class="btn add-btn">
    <a href="/add">Add Book</a>
</button>

<div class="flex sort-buttons">
    <button class="btn sort-btn">
        <a href="/sort/title">Sort by Title</a>
    </button>
    <button class="btn sort-btn">
        <a href="/sort/date">Sort by Date</a>
    </button>
    <button class="btn sort-btn">
        <a href="/sort/rating">Sort by Rating</a>
    </button>
</div>

<div class="grid">
    <% if (locals.books) { %>
        <% for (let book of locals.books) { %>
            <img src="<%= book.cover_img_src %>" alt="<%= book.title %> cover">
            <div>
                <h3><%= book.title %></h3>
                <div class="book-information">
                    <p><%= book.date.toDateString() %></p>
                    <p><%= book.rating %> / 10</p>
                </div>
                <p><%= book.notes %></p>
                <div class="buttons">
                    <form action="/edit" method="POST">
                        <input type="hidden" name="id" value="<%= book.id %>">
                        <input type="hidden" name="title" value="<%= book.title %>">
                        <input type="hidden" name="rating" value="<%= book.rating %>">
                        <input type="hidden" name="date" value="<%= book.date %>">
                        <input type="hidden" name="notes" value="<%= book.notes %>">
                        <button type="submit" class="btn edit-btn">Edit</button>
                    </form>
                    <form action="/delete" method="POST">
                        <input type="hidden" name="id" value="<%= book.id %>">
                        <button type="submit" class="btn delete-btn">Delete</button>
                    </form>
                </div>
            </div>
        <% } %>
    <% } %>
</div>

<%- include("partials/footer.ejs") %>